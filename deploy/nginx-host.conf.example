# Host Nginx config. Issue the hostname certificate before installing the TLS block.
server {
    listen 80;
    server_name bluesteam.webinprogress.click;
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name bluesteam.webinprogress.click;
    ssl_certificate /etc/letsencrypt/live/bluesteam.webinprogress.click/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bluesteam.webinprogress.click/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    client_max_body_size 210m;
    add_header X-BlueSTEAM-Origin bluesteam always;
    error_page 502 504 =503 /__bluesteam_unavailable;

    location = /__bluesteam_unavailable {
        internal;
        default_type text/plain;
        return 503 "BlueSTEAM is awaiting its first successful deployment.\n";
    }

    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
